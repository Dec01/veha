__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
.idea/
.env

# Артефакты и рабочие каталоги
atlas/
reports/
logs/

# Локальный слой документации и закрытые имена
docs/raw/
.private-names

# Данные установки в репозиторий не попадают, даже во временных файлах
_tmp_*
*.local.yaml

# Демонстрационный набор — исключение из двух правил выше.
#
# `atlas/` и `logs/` закрыты потому, что это артефакты живой установки: данные
# установки в репозиторий не попадают. В `demo/` лежит не установка, а вымышленный
# набор, и он обязан приезжать вместе с репозиторием: иначе после клонирования
# показывать нечего, а демонстрация обычно нужна раньше, чем находится время
# разбираться, почему сцена пустая.
!demo/atlas/
!demo/atlas/**
!demo/logs/
!demo/logs/**
