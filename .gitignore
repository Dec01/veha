__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
.idea/
.env

# Артефакты и рабочие каталоги
# плагин partest под pytest-xdist складывает сюда call_storage воркеров
.partest/
atlas/
reports/
logs/

# Локальный слой документации и закрытые имена
docs/raw/
.private-names

# Данные установки в репозиторий не попадают, даже во временных файлах
_tmp_*
*.local.yaml

# Демонстрационный набор — исключение из двух правил выше.
#
# `atlas/` и `logs/` закрыты потому, что это артефакты живой установки: данные
# установки в репозиторий не попадают. В `veha/demo_data/` лежит не установка, а
# вымышленный набор (его пишет `demo/generate.py`), и он обязан приезжать и с
# репозиторием, и в колесе — `veha demo` показывает именно его.
!veha/demo_data/atlas/
!veha/demo_data/atlas/**
!veha/demo_data/logs/
!veha/demo_data/logs/**
